<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".ui.order.OrderFragment">

  <ImageView
      android:layout_marginTop="100dp"
      android:id="@+id/ivLogo"
      android:layout_width="200dp"
      android:layout_height="201dp"
      android:src="@drawable/ic_empty_order"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ouch! Hungry"
        style="@style/TextView.PoppinsNormal20sp8D92A3"
        android:layout_marginTop="30dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seem like you have not\nordered any food yet"
        android:textAlignment="center"
        style="@style/TextView.PoppinsNormal14sp8D92A3"
        android:layout_marginTop="6dp"/>
    
    <Button
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        style="@style/Button.Primary"
        android:text="Find Foods"
        android:textAllCaps="false"
        android:layout_marginTop="30dp"/>
</LinearLayout>